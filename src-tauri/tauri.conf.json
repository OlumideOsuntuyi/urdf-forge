{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "URDF Forge",
  "version": "0.1.0",
  "identifier": "io.github.olumideosuntuyi.urdfforge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "URDF Forge",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' blob:",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://acg-media.struffelproductions.com",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "URDF Forge contributors",
    "copyright": "Copyright 2026 URDF Forge contributors. Apache-2.0.",
    "shortDescription": "STEP/STL to ROS 2 robot descriptions",
    "longDescription": "URDF Forge imports STEP and STL CAD models, breaks them into links, sets joints and hierarchy, previews motion and physics, and exports ROS 2 description packages for Humble, Jazzy, Kilted, Lyrical and Rolling.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["forge"],
        "name": "URDF Forge project",
        "description": "URDF Forge project",
        "mimeType": "application/x-urdf-forge",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": { "section": "science" },
      "rpm": {}
    },
    "windows": {
      "nsis": { "installMode": "both" }
    }
  }
}
